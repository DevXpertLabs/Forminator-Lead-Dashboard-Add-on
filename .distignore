# Files and directories that should NOT ship in the distributed plugin zip.
# Used by `wp dist-archive` (WP-CLI) when building the release.

/.git
/.github
/.claude
/.gitignore
/.distignore
/phpcs.xml.dist
/phpunit.xml.dist
/composer.json
/composer.lock
/README.md
/CHANGELOG.md
/HANDOVER.md
/bin
/docs
/node_modules
/vendor
/tests

# README screenshots (GitHub only; WP.org screenshots live in SVN /assets)
/image.png
/image-1.png
/image-2.png
